// Global Class
#include <iostream>
using namespace std;
class A {
    protected:
     int a,b;
    public:
        void input(){
            cout<<"Enter two value:";
            cin>>a>>b;
        }
        void show(){
            cout<<"This is class A ->"<<a<<" "<<b<<endl;
        }
};
class B:public A 
{
    public:
     void disp(){
         cout<<"This is class B ->"<<a<<" "<<b;
     }
};
int main(){
    // A obj; 
    B obj2;
    obj2.input();
    obj2.show();
    obj2.disp();
    return 0;
}
